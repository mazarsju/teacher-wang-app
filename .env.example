# Copy to `.env` and adjust for your machine (`.env` is gitignored).
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/teacher_wang
# Dedicated DB for backend unit/integration tests (never point this at production data).
TEST_DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/teacher_wang_test

# ECS / Docker alternative to DATABASE_URL (used when DATABASE_URL is unset):
# DB_HOST=...
# DB_PORT=5432
# DB_NAME=teacherwang
# DB_USER=teacherwang
# DB_PASSWORD=...

# Cognito (from teacher-wang-infra terraform outputs). Required for GET /auth/me
# and future protected routes. Issuer can be omitted — derived from region + pool id.
# COGNITO_REGION=eu-west-1
# COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_XXXXXXXXX

# Frontend Vite (same pool; public client ids only — no secrets). Loaded from this
# repo-root `.env` via frontend/vite.config.ts `envDir`.
# VITE_COGNITO_REGION=eu-west-1
# VITE_COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
# VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_DOMAIN=teacher-wang-prod-XXXXXXXXX
# VITE_COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_XXXXXXXXX

# Conversation logs (default: local filesystem under conversation_logs/users/{sub}/).
# For local development prefer BACKEND=local. Prod ECS sets BACKEND=s3 + bucket.
#
# Local S3 testing: CONVERSATION_LOGS_* alone is not enough. boto3 also needs AWS
# credentials for the *same account* as the bucket name suffix (e.g. …-448406924960).
# Source teacher-wang-infra/config, or set AWS_PROFILE / AWS_ACCESS_KEY_ID here.
# Verify with: aws sts get-caller-identity  (Account must match the bucket).
# CONVERSATION_LOGS_BACKEND=local
# CONVERSATION_LOGS_DIR=./conversation_logs
# CONVERSATION_LOGS_BACKEND=s3
# CONVERSATION_LOGS_S3_BUCKET=teacher-wang-prod-conversation-logs-XXXXXXXXX
# CONVERSATION_LOGS_S3_REGION=eu-west-1
# CONVERSATION_LOGS_S3_PREFIX=
# AWS_PROFILE=teacher-wang
# AWS_DEFAULT_REGION=eu-west-1
# GRAMMAR_CONTENT_S3_PATH=./grammar_content
# GRAMMAR_CONTENT_S3_BUCKET=teacher-wang-prod-grammar-content-XXXXXXXXX